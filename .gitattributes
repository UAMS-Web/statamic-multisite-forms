* text=auto eol=lf

*.php text eol=lf
*.{json,md,xml,yml,yaml,neon,dist} text eol=lf

*.{png,gif,jpg,jpeg,webp,ico,pdf,zip} -text

# Development-only paths stay out of `git archive` and release packaging.
/.gitattributes export-ignore
/.github/ export-ignore
/composer.lock export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/rector-sweep.php export-ignore
/rector.php export-ignore
/tests/ export-ignore
/vendor/ export-ignore
